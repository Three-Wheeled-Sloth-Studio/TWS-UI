{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true
  },
  "references": [
    { "path": "../tokens" },
    { "path": "../theme" }
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
